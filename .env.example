# ── Required ────────────────────────────────────────────────
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (send /id to the bot, or ask @userinfobot). Comma-separate for more.
TELEGRAM_ALLOWED_USER_IDS=

# ── AI models: set at least one provider key ────────────────
# Run `python3 deploy/configure.py` to enter and verify them interactively.
# Switch models any time in Telegram with /model; see lifeagent/models.py for the list.
# Anthropic (Claude) — recommended. console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# OpenRouter — one key for Claude, GPT, Gemini, Grok... openrouter.ai/keys
OPENROUTER_API_KEY=
# DeepSeek — very cheap; cannot read images. platform.deepseek.com
DEEPSEEK_API_KEY=
# Moonshot Kimi / Z.ai GLM (Anthropic-compatible endpoints)
MOONSHOT_API_KEY=
ZAI_API_KEY=
# OpenAI / Gemini with your own keys go through the LiteLLM gateway container
# (deploy/litellm/config.yaml). The wizard fills these and sets COMPOSE_PROFILES=gateway.
GEMINI_API_KEY=
LITELLM_MASTER_KEY=
COMPOSE_PROFILES=
# Any other Anthropic-compatible endpoint (provider "custom" in data/models.toml)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Default model alias or id: sonnet (economical, default) | opus | fable | haiku |
# or-sonnet | or-gpt | or-gemini | deepseek | deepseek-pro | gpt | gemini | ...
LIFEAGENT_MODEL=sonnet
# Used automatically for 30 minutes when the default provider fails (credit, outage, rate limit)
LIFEAGENT_FALLBACK_MODEL=
# low | medium | high | xhigh | max   (Claude only; higher = smarter, slower, more expensive)
LIFEAGENT_EFFORT=medium
LIFEAGENT_MAX_TURNS=40
LIFEAGENT_TIMEZONE=Asia/Tehran

# ── Routines (leave empty to disable one) ──────────────────
MORNING_BRIEF_TIME=08:00
# proactive midday nudge (stays silent when there is nothing useful)
MIDDAY_CHECKIN_TIME=14:00
EVENING_CHECKIN_TIME=23:00
# day (sat..fri) and time
WEEKLY_REVIEW=fri 18:00
# runs on the 1st of each Jalali month
MONTHLY_REPORT_TIME=09:00
# weekly AI news digest + post ideas
AI_DIGEST=thu 10:00

# ── Prayer-time reminders (aladhan.com) ─────────────────────
PRAYER_REMINDERS=false
PRAYER_CITY=Tehran
PRAYER_COUNTRY=Iran
# 7 = Institute of Geophysics, University of Tehran
PRAYER_METHOD=7
# any of: fajr,sunrise,dhuhr,asr,sunset,maghrib,isha,midnight
PRAYER_TIMES=fajr,dhuhr,maghrib

# ── Voice messages (optional) ───────────────────────────────
# Groq has a free tier (console.groq.com); OpenAI works too. auto = Groq first.
GROQ_API_KEY=
OPENAI_API_KEY=
TRANSCRIBE_PROVIDER=auto
# empty = provider default (whisper-large-v3-turbo on Groq, whisper-1 on OpenAI)
TRANSCRIBE_MODEL=
# empty = auto-detect (Persian and English voice notes); or fa / en
TRANSCRIBE_LANGUAGE=

# ── Google: Gmail / Calendar / Drive / Tasks / Docs / Sheets (optional) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=

# ── GitHub (optional) — fine-grained PAT ────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOOLSETS=repos,issues,pull_requests,actions,notifications

# ── More tools ──────────────────────────────────────────────
# Default city for weather
LIFEAGENT_CITY=Tehran
# Context7: up-to-date library docs for coding questions (free key at context7.com raises limits)
ENABLE_CONTEXT7=true
CONTEXT7_API_KEY=
# Headless browser (Playwright MCP). Also build with INSTALL_BROWSER=true in docker-compose.yml
ENABLE_BROWSER=false
# Web search for non-Claude models: Tavily if set (free 1,000/month at tavily.com), else Exa's keyless tier
TAVILY_API_KEY=
# Iranian free-market dollar/euro/gold/coin prices in Toman (free key at brsapi.ir)
BRSAPI_KEY=

# ── Finance ─────────────────────────────────────────────────
# Show a confirmation card with an undo button after each recorded transaction
FINANCE_CONFIRM_CARDS=true

# ── Safety & cost ───────────────────────────────────────────
# true = run shell commands without asking (not recommended)
AUTO_APPROVE_BASH=false
APPROVAL_TIMEOUT_SECONDS=900
# The "allow similar for N minutes" button (shell, workspace files, browser only — never email/GitHub)
TRUST_WINDOW_MINUTES=30
# Warn once a day when estimated API spend passes this (USD)
DAILY_BUDGET_USD=3
LOG_LEVEL=INFO
